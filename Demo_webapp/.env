# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored/dockerignored on purpose --
# never commit real passwords.

# --- MySQL server (the "db" container) ---
MYSQL_ROOT_PASSWORD=smartbiopep_12345
MYSQL_DATABASE=smartbiopep

# --- db.py / api container: how it connects to MySQL ---
# DB_HOST=db matches the service name below in docker-compose.yml -- Docker's
# built-in DNS resolves that name to the db container's IP on the shared
# network. This would be 127.0.0.1 only if MySQL ran on the same machine
# outside a container.
DB_HOST=web_db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=smartbiopep_12345
DB_NAME=smartbiopep

# --- frontend container: how it reaches the API ---
SMARTBIOPEP_API_BASE_URL=http://web_api:8000

# --- web_api container: the browser-facing URL it puts in emailed result links --
SMARTBIOPEP_APP_URL=http://localhost:8501
